<%- layout("/includes/head") %>

    <body>
        <div class="row my-3">
            <div class="col-8 offset-2">
                <h5>Add course</h5>
                <form action="/courses" method="POST">
                    <div class="mb-3"><label for="title" class="form-label">Title</label>
                        <input type="text" placeholder="Enter course title" name="Course[title]" class="form-control">
                    </div>
                    <div class="mb-3"><label for="description" class="form-label">Description</label>
                        <textarea name="Course[description]" class="form-control">Add description</textarea>
                    </div>
                    <div class="mb-3"><label for="img" class="form-label">Image Url</label>
                        <input type="text" name="Course[img]" placeholder="Image Url/Link" class="form-control">
                    </div>
                    <div class="row">
                        <div class="mb-3 col-6"><label for="price" class="form-label">Course price</label>
                            <input type="text" name="Course[price]" placeholder="Enter course price"
                                class="form-control">
                        </div>
                        <div class="mb-3 col-6"><label for="duration" class="form-label">Duration</label>
                            <input type="text" placeholder="e.g 6 months" name="Course[duration]" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3"><label for="instructor" class="form-label">Instructor Name</label>
                        <input type="text" placeholder="Enter course instructor" name="Course[instructor]">
                    </div>

                    <button class="btn btn-outline-primary" style="background-color: #ffb703; border: none; color: #fff;">Add</button>
                </form>
            </div>
        </div>
    </body>