<%- layout("/includes/head") %>

    <body>
        <div class="row row-cols-lg-4 row-cols-md-4">
            <% for(const course of courses ) { %>
                <div class="card" style="width: 18rem;">
                    <img src="<%= course.img %>" class="card-img-top" alt="<%= course.title %>" style="height: 18rem;">
                    <div class="card-body d-flex flex-column gap-2">
                        <!-- Price Highlighted -->
                        <a href="/courses/<%= course.id %>" class="text-decoration-none">
                            <h5 class="card-title text-success font-weight-bold mb-1">
                                <%= course.title %>
                            </h5>
                        </a>

                        <h6 class="card-title mb-1">
                            &#x20B9;<%= course.price.toLocaleString("en-IN") %>
                        </h6>

                        <!-- Metadata Flex Rows -->
                        <div class="d-flex justify-between w-100 fs-6">
                            <span class="text-muted">Instructor: &nbsp;</span>
                            <span class="text-dark font-weight-medium">
                                <%= course.instructor %>
                            </span>
                        </div>

                        <div class="d-flex justify-between w-100 fs-6 text-secondary">
                            <span>Duration: &nbsp;</span>
                            <span>
                                <%= course.duration %>
                            </span>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>
    </body>