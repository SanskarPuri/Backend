<%- layout("/includes/head") %>

    <body>
        <div class="container my-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <!-- Card removed fixed width to let grid control size -->
                    <div class="card shadow-sm">
                        <!-- Adjusted image style for a wide banner look -->
                        <img src="<%= course.img %>" class="card-img-top" alt="<%= course.title %>"
                            style="height: 25rem; object-fit: cover;">

                        <div class="card-body">
                            <h2 class="card-title text-danger font-weight-bold mb-3">
                                <%= course.title %>
                            </h2>
                            <p class="card-text text-muted lead">
                                <%= course.description %>
                            </p>
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <strong>Price:</strong> &#x20B9;<%= course.price.toLocaleString("en-IN") %>
                            </li>
                            <li class="list-group-item">
                                <strong>Instructor:</strong>
                                <%= course.instructor %>
                            </li>
                            <li class="list-group-item">
                                <strong>Duration:</strong>
                                <%= course.duration %>
                            </li>
                        </ul>

                        <!-- Flexbox alignment keeps buttons inline -->
                        <div class="card-body d-flex gap-2">
                            <a href="/courses/<%= course.id %>/edit" class="btn btn-success edit" style="background-color: #ffb703; border: none; color: #fff;">Edit Course</a>
                            <form action="/courses/<%= course.id %>?_method=DELETE" method="POST" class="m-0">
                                <button class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>