<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="index.css">
</head>
<body>
<div class="bg-success p-2 text-dark bg-opacity-10">
    <div class="text-center my-4">
        <h1 class="fw-bold text-primary display-4">
            DevDiary
        </h1>
        <p class="text-muted">
            Share • Learn • Grow
        </p>
    </div>
    <div class="container mt-4">
        <div class="row g-4">   <!-- g-4 = gap between columns -->
            <% for(let blog of blogs) { %>

            <div class="col-md-4">  <!-- 3 cards per row -->
                <div class="card h-100 shadow-sm">

                    <div class="card-header text-center">
                        <h5><%= blog.title %></h5>
                    </div>

                    <div class="card-body">
                        <p class="text-muted mb-1">by <%= blog.author %></p>
                        <p><%= blog.content.substring(0, 100) %>...</p>

                        <a href="/blogs/<%= blog.id %>" class="btn btn-sm btn-warning">Read</a>
                        <a href="/blogs/<%= blog.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>

                        <form method="post" action="/blogs/<%= blog.id %>?_method=DELETE" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>

                </div>
            </div>

            <% } %>
        </div>
    </div>
    <br>
    <br>
    <br>
     <div class="text-center my-4">
    <a href="/blogs/new" class="btn btn-success">
        Create Your Blog
    </a>
</div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</html>